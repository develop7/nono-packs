{
  "schema_version": 1,
  "name": "jcode",
  "version": "0.1.0",
  "description": "J-Code coding agent profile for working inside a nono security sandbox.",
  "license": "Apache-2.0",
  "platforms": ["macos", "linux"],
  "min_nono_version": "0.64.1",
  "artifacts": [
    { "type": "profile", "path": "policy.json", "install_as": "jcode" },
    { "type": "plugin", "path": "README.md" },
    { "type": "plugin", "path": "wiring/profile-drafts-dir-marker" }
  ],
  "wiring": [
    {
      "type": "write_file",
      "source": "wiring/profile-drafts-dir-marker",
      "dest": "$NONO_CONFIG/profile-drafts/.nono-jcode-pack-marker"
    }
  ]
}
